# development = 离线 Mock；staging = Live 验收；production = 单机部署
APP_ENV=development
STORAGE_ROOT=.
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_PUBLIC_BIND=false
# Keep disabled locally. Railway/public deployment enables this and configures
# both values as service secrets, never in this file.
ACCESS_AUTH_ENABLED=false
ACCESS_INVITE_CODE=
ACCESS_COOKIE_SECRET=
ACCESS_COOKIE_SECURE=false
DATABASE_URL=sqlite:///./data/research.db
ARTIFACTS_DIR=./data/artifacts
LOGS_DIR=./logs
BACKUPS_DIR=./backups
MAX_PENDING_RUNS=20
WORKER_POLL_INTERVAL=1
WORKER_STEP_DELAY=1
LOG_LEVEL=INFO
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db

PI_RUNTIME_MODE=mock
PI_BRIDGE_COMMAND=node
PI_BRIDGE_ENTRY=./pi_bridge/dist/index.js
PI_BRIDGE_START_TIMEOUT=15
PI_REQUEST_TIMEOUT=120
PI_BRIDGE_MAX_RESTARTS=1

PI_MODEL_PROVIDER=
PI_MODEL=
PI_API_KEY_ENV_NAME=

AGENT_PROFILE_DIR=./app/profiles
MAX_AGENT_CONTEXT_CHARS=50000
MAX_AGENT_OUTPUT_CHARS=20000
# 单节点工具调用上限；AgentProfile.max_tool_calls 与此取 min 作为运行时上限（schema le=25）
MAX_TOOL_CALLS_PER_NODE=25
TOOL_DEFAULT_TIMEOUT=30
OUTPUT_REPAIR_ATTEMPTS=1

MARKET_DATA_MODE=mock
MARKET_DATA_PROVIDER=akshare
MARKET_DATA_LOOKBACK_DAYS=750
MARKET_DATA_MIN_BARS=120
MARKET_DATA_ADJUSTMENT=qfq
MARKET_DATA_MAX_RETRIES=2

TECHNICAL_INDICATOR_VERSION=tech_indicator_v1

KRONOS_MODE=mock
KRONOS_MODEL_NAME=
KRONOS_DEVICE=cpu
KRONOS_SOURCE_DIR=./vendor/kronos
KRONOS_LOOKBACK=400
KRONOS_PREDICTION_LENGTH=20
KRONOS_TIMEOUT_SECONDS=300

TECHNICAL_RESEARCH_PROFILE=technical_research
TECHNICAL_ASSEMBLY_PROFILE=technical_assembly
TECHNICAL_WORKFLOW_VERSION=technical_v1

FUNDAMENTAL_DATA_MODE=mock
FUNDAMENTAL_DATA_PROVIDER=akshare
FUNDAMENTAL_DATA_MAX_RETRIES=2

RESEARCH_SEARCH_MODE=mock
# Live 检索适配器：official_crawler | akshare_news | akshare_reports | akshare_notices | tavily | keenable | firecrawl | aggregator
# aggregator 会 fan-out 到 RESEARCH_SEARCH_PROVIDERS 列出的来源并做去重/重排/失败隔离
RESEARCH_SEARCH_PROVIDER=
# 仅 RESEARCH_SEARCH_PROVIDER=aggregator 时生效；逗号分隔的来源列表，不能包含 aggregator 自身
# 留空时默认 official_crawler,akshare_news,akshare_reports,akshare_notices
RESEARCH_SEARCH_PROVIDERS=
# Firecrawl 仅作为可选搜索 Provider；填入后将 firecrawl 加入上面的聚合列表。
FIRECRAWL_API_KEY=
# 仅 tavily/keenable/firecrawl 需要填写 API Key 环境变量名；akshare 来源与 official_crawler 无需 Key
RESEARCH_SEARCH_API_KEY_ENV_NAME=
RESEARCH_SEARCH_MAX_RESULTS=8
RESEARCH_SOURCE_TIMEOUT=30
RESEARCH_MAX_SOURCE_CHARS=20000
RESEARCH_MAX_PDF_BYTES=20000000
# Reader service for the read path. none=legacy local download+extract (offline/tests);
# jina=Jina Reader (keyless, rate-limited; key optional via RESEARCH_READER_API_KEY_ENV_NAME);
# firecrawl=Firecrawl scrape (key required). Live A-share sources (JS-rendered detail
# shells, anti-bot PDFs) need a reader; set jina for keyless, or firecrawl if you have a key.
RESEARCH_READER=none
RESEARCH_READER_API_KEY_ENV_NAME=
RESEARCH_READER_TIMEOUT=30

# FinDKG is an optional, local Lead Planning knowledge-hint dataset. Point this
# directory at the folder containing entity2id.txt, relation2id.txt and train.txt.
FINDKG_DATA_DIR=./data/findkg/FinDKG

FINANCIAL_METRIC_VERSION=financial_metric_v1
VALUATION_SCRIPT_VERSION=valuation_v1

FUNDAMENTAL_LEAD_PROFILE=fundamental_lead
BUSINESS_RESEARCH_PROFILE=business_research
INDUSTRY_RESEARCH_PROFILE=industry_research
FINANCIAL_RESEARCH_PROFILE=financial_research
VALUATION_RESEARCH_PROFILE=valuation_research
FUNDAMENTAL_WRITER_PROFILE=fundamental_writer
FINAL_SYNTHESIS_PROFILE=final_synthesis
CHART_DATA_EXTRACTOR_PROFILE=chart_data_extractor
FUNDAMENTAL_WORKFLOW_VERSION=fundamental_v1

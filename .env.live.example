# Copy to .env only after setting DEEPSEEK_API_KEY locally.
# This file intentionally contains no secret values.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_PUBLIC_BIND=false
STORAGE_ROOT=.
DATABASE_URL=sqlite:///./data/research.db
ARTIFACTS_DIR=./data/artifacts
LOGS_DIR=./logs
BACKUPS_DIR=./backups
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db

# Pi Agent Runtime: native DeepSeek provider from @earendil-works/pi-ai.
PI_RUNTIME_MODE=live
PI_BRIDGE_COMMAND=node
PI_BRIDGE_ENTRY=./pi_bridge/dist/index.js
PI_MODEL_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
PI_API_KEY_ENV_NAME=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# Deterministic market and fundamental data adapters.
MARKET_DATA_MODE=live
MARKET_DATA_PROVIDER=akshare
FUNDAMENTAL_DATA_MODE=live
FUNDAMENTAL_DATA_PROVIDER=akshare

# Official Kronos mini model, MPS on Apple Silicon with CPU fallback.
KRONOS_MODE=live
KRONOS_MODEL_NAME=NeoQuasar/Kronos-mini
KRONOS_DEVICE=mps
KRONOS_SOURCE_DIR=./vendor/kronos

# Multi-source retrieval. aggregator fans out to RESEARCH_SEARCH_PROVIDERS and
# merges results with cross-source dedup, reranking, source tagging and
# per-source failure isolation. Keyless sources (official_crawler, akshare_*,
# need no API key; tavily/firecrawl need one.
RESEARCH_SEARCH_MODE=live
RESEARCH_SEARCH_PROVIDER=aggregator
# Comma-separated member sources; must not include aggregator itself.
# Default when empty: official_crawler,akshare_news,akshare_reports,akshare_notices
RESEARCH_SEARCH_PROVIDERS=official_crawler,akshare_news,akshare_reports,akshare_notices
RESEARCH_SEARCH_API_KEY_ENV_NAME=
RESEARCH_SEARCH_MAX_RESULTS=8
# To add tavily/firecrawl later: append to RESEARCH_SEARCH_PROVIDERS and set
# RESEARCH_SEARCH_API_KEY_ENV_NAME=TAVILY_API_KEY / FIRECRAWL_API_KEY + export.
RESEARCH_MAX_PDF_BYTES=20000000
# Reader service renders JS and normalizes anti-bot PDFs to clean markdown for the
# read path. Jina Reader is keyless (rate-limited); set RESEARCH_READER=jina for the
# simplest live setup. Firecrawl scrape also works if you have a FIRECRAWL_API_KEY.
# The reader distinguishes transient (retry once) from unreadable (skip, don't
# retry) so the agent stops burning its tool budget on failing sources.
RESEARCH_READER=jina
RESEARCH_READER_API_KEY_ENV_NAME=
RESEARCH_READER_TIMEOUT=30
